     cookie=0x0, duration=12.791s, table=0, n_packets=718, n_bytes=25219607, priority=50,dl_dst=00:00:00:00:00:01 actions=output:1
     cookie=0x0, duration=12.755s, table=0, n_packets=41, n_bytes=2762, priority=50,dl_dst=00:00:00:00:00:11 actions=output:2
     cookie=0x0, duration=12.728s, table=0, n_packets=35, n_bytes=2366, priority=50,dl_dst=00:00:00:00:00:12 actions=output:3
     cookie=0x0, duration=12.700s, table=0, n_packets=40, n_bytes=2720, priority=50,dl_dst=00:00:00:00:00:13 actions=output:4
